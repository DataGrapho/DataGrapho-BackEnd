# Copie este arquivo para .env e preencha os segredos localmente.
# Nunca versione o arquivo .env real.
DEBUG=True
SECRET_KEY=troque-por-uma-chave-django-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# Vite local (5173) e frontend servido pelo container Nginx (4173).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

DB_ENGINE=django.db.backends.postgresql
DB_NAME=datagrapho
DB_USER=datagrapho
DB_PASSWORD=troque-esta-senha
DB_HOST=db
DB_PORT=5432

AI_PROVIDER=gemini
AI_API_KEY=adicione-sua-chave-gemini-aqui
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT=90
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.0
MAX_TOOL_CALLS_PER_QUESTION=5
CHATBOT_RATE_LIMIT=10
CHATBOT_CACHE_TTL=300
CHATBOT_SESSION_EXPIRY=3600
CHATBOT_ACTIVE_DOMAINS=wine
